# Copy to `.env` (development) or `.env.production` (production build).

# Public URL of the deployed site. Used for canonical URL, Open Graph, sitemap.xml and robots.txt.
VITE_SITE_URL=http://localhost:5173

# Leave empty in development (Vite proxies /api to Flask on :5000).
# In production set to the deployed API, e.g. https://api.your-domain.example/api
VITE_API_BASE_URL=
