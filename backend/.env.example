# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

FLASK_ENV=development

# Long random strings. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Local development: SQLite (zero setup).
DATABASE_URL=sqlite:///fairytale.db
# Production: PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/fairytale

# Allowed browser origins (comma separated)
CORS_ORIGINS=http://localhost:5173

# Uploads
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=8

# First admin account — used ONLY by the one-time seed script (Phase 5).
# Choose your own; there is intentionally no default password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Phase 4: forms & notifications ----

# Rate limits per visitor IP. In production with several workers use Redis: redis://localhost:6379/0
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_RESERVATIONS=6 per hour;20 per day
RATELIMIT_CONTACT=6 per hour;20 per day
# Number of reverse proxies in front of Flask (nginx, a PaaS router...). 0 when running directly.
TRUSTED_PROXY_COUNT=0

# Booking rules. Opening hours are NOT enforced here; they arrive with the Phase 5 dashboard.
MAX_PARTY_SIZE=20
MAX_ADVANCE_DAYS=90
MIN_LEAD_MINUTES=30

# Optional email alert to the owner for every booking / message. Leave SMTP_HOST empty to skip.
# (Gmail: use an App Password, port 587.)
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# ---- Phase 5: admin ----
# Admin sign-in lifetime and brute-force limit
JWT_EXPIRES_HOURS=8
RATELIMIT_LOGIN=5 per minute;30 per hour
