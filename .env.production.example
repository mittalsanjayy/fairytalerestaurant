# Copy to `.env` next to docker-compose.yml. NEVER commit `.env`.

# Your domain WITHOUT https:// (Caddy gets the certificate automatically; DNS must point at this server).
SITE_ADDRESS=fairytale.example
# The full public address WITH https://
SITE_URL=https://fairytale.example

# Use letters and digits only for the database password (it is placed inside a URL).
POSTGRES_PASSWORD=
# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Optional: email the owner for every booking / message (Gmail: use an App Password)
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
